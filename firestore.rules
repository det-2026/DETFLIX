rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      allow read, write: if true;
    }
    match /appSettings/{settingsId} {
      allow read, write: if true;
    }
    match /plans/{planId} {
      allow read, write: if true;
    }
    match /comments/{commentId} {
      allow read, write: if true;
    }
  }
}
